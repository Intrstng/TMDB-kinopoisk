{
  "name": "tmdb-kinopoisk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "stylelint:check": "npx stylelint \"**/*.css\"",
    "stylelint:fix": "npx stylelint --fix \"**/*.css\"",
    "prepare": "husky"
  },
  "dependencies": {
